# Copy to .env for local development. Never commit the real .env.

MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http   # for local streamable-http testing / production

# Cosmos DB (dev account per plan §11 / §13 phase 2)
COSMOS_ENDPOINT=
COSMOS_KEY=

# Blob storage (Azurite for local dev: UseDevelopmentStorage=true)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Embeddings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Telegram bot delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Microsoft Graph (calendar + contacts)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=

# Only used when MCP_TRANSPORT=http
MCP_BEARER_TOKEN=
