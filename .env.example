# Copy to .env for local development. Never commit the real .env.

MCP_TRANSPORT=stdio
# MCP_TRANSPORT=http   # for local streamable-http testing / production

# Cosmos DB (dev database per plan §11 / §13 phase 2)
# Auth is via AAD (DefaultAzureCredential -> your `az login` session), granted
# by infra/05-cosmos-account.sh's data-plane role assignment. Only set
# COSMOS_KEY if you're not using RBAC.
COSMOS_ENDPOINT=https://lifedb.documents.azure.com:443/
COSMOS_DATABASE_NAME=personaldb-dev
COSMOS_KEY=
# ARM (control-plane) coordinates, needed only for dynamic container create/update —
# AAD data-plane RBAC can't do container/database structural changes (aka.ms/cosmos-native-rbac).
COSMOS_SUBSCRIPTION_ID=a7edb0c9-d49d-4c7c-a3d7-776c14e253d2
COSMOS_RESOURCE_GROUP=lifedb
COSMOS_ACCOUNT_NAME=lifedb

# Blob storage (Azurite for local dev: UseDevelopmentStorage=true)
AZURE_STORAGE_CONNECTION_STRING=UseDevelopmentStorage=true

# Embeddings
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_KEY=
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Telegram bot delivery
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Microsoft Graph (calendar + contacts)
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_REFRESH_TOKEN=

# Only used when MCP_TRANSPORT=http
MCP_BEARER_TOKEN=
